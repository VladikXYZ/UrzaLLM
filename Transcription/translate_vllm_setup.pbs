#!/bin/bash
# MetaCentrum CPU job: the vLLM environment and the candidate translation models (downloaded once).
#     cd ~/urza_translate && qsub -o logs/ code/translate_vllm_setup.pbs
#PBS -N urza_vllm_setup
#PBS -l select=1:ncpus=4:mem=16gb:scratch_local=60gb
#PBS -l walltime=4:00:00
#PBS -j oe
set -euo pipefail

WORK=${WORK:-$PBS_O_WORKDIR}
UV=${UV:-/storage/praha1/home/rolloj/urza_asr_bench/uvpkg/bin/uv}
# set, not defaulted: the compute nodes preset HF_HOME to the job's scratch, and the models would be
# downloaded there and deleted with it (the first run did exactly that)
export HF_HOME=/storage/praha1/home/rolloj/urza_asr_bench/hf-cache HF_HUB_CACHE=/storage/praha1/home/rolloj/urza_asr_bench/hf-cache/hub
export UV_CACHE_DIR=$SCRATCHDIR/uv-cache UV_PYTHON_INSTALL_DIR=$WORK/python UV_LINK_MODE=copy TMPDIR=$SCRATCHDIR
MODELS=${MODELS:-"mistralai/Mistral-Small-3.2-24B-Instruct-2506 utter-project/EuroLLM-22B-Instruct-2512 Qwen/Qwen3-30B-A3B-Instruct-2507"}
cd "$WORK"
trap 'clean_scratch' EXIT

[ -x venv_vllm/bin/python ] || { $UV venv -p 3.12 --seed venv_vllm && $UV pip install -p venv_vllm/bin/python vllm huggingface_hub hf_transfer; }
venv_vllm/bin/python -c "import vllm, torch; print('vllm', vllm.__version__, 'torch', torch.__version__)"

export HF_HUB_ENABLE_HF_TRANSFER=1
for m in $MODELS; do
    venv_vllm/bin/python -c "
from huggingface_hub import snapshot_download
p = snapshot_download('$m', allow_patterns=['*.json', '*.safetensors', '*.model', '*.txt', 'tekken.json', 'params.json'])
print('$m ->', p)"
done
du -sh "$HF_HOME"/hub/models--* 2>/dev/null
echo SETUP_OK
